# Images
POSTGRES_VERSION=15
SPARK_VERSION=3.5.0
AIRFLOW_IMAGE_TAG=2.8.1

# Airflow
AIRFLOW_UID=50000
DB_AIRFLOW_USER=airflow
DB_AIRFLOW_PASSWORD=airflow_password

# Postgres metier
DB_BUSINESS_USER=business_user
DB_BUSINESS_PASSWORD=business_password
DB_BUSINESS_NAME=business_db

# Roles Postgres metier
PG_DE_PASSWORD=data_engineer_password
PG_DS_PASSWORD=data_scientist_password
PG_DA_PASSWORD=data_analyst_password

# MinIO root
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin_password

# MinIO RBAC users
MINIO_DE_USER=data_engineer
MINIO_DE_PASSWORD=data_engineer_minio_password
MINIO_DS_USER=data_scientist
MINIO_DS_PASSWORD=data_scientist_minio_password
